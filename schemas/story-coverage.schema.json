{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Story coverage",
  "type": "object",
  "required": ["coverage"],
  "properties": {
    "coverage": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "event_id", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "status": { "enum": ["COVERED", "OMITTED"] },
          "screenplay_scene_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Props",
  "type": "object",
  "required": ["props"],
  "properties": {
    "props": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "claims": { "type": "array" }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

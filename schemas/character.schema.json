{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Character",
  "type": "object",
  "required": ["characters"],
  "properties": {
    "characters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "claims"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "faction_id": { "type": ["string", "null"] },
          "source_refs": { "type": "array", "items": { "type": "string" } },
          "claims": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["text", "provenance"],
              "properties": {
                "text": { "type": "string", "minLength": 1 },
                "provenance": { "enum": ["SOURCE_FACT", "INFERENCE", "ART_DECISION", "UNKNOWN"] },
                "source_refs": { "type": "array", "items": { "type": "string" } },
                "note": { "type": "string" }
              }
            }
          }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

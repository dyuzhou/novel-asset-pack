{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event beat coverage",
  "type": "object",
  "required": ["beats"],
  "properties": {
    "beats": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "event_id", "beat_type", "text", "evidence_refs", "screenplay_scene_ids", "screenplay_segment_ids", "shot_ids"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "event_id": { "type": "string", "minLength": 1 },
          "beat_type": { "enum": ["CAUSE", "PROCESS", "KEY_ACTION", "DIALOGUE", "REACTION", "RESULT", "CONSEQUENCE"] },
          "text": { "type": "string", "minLength": 1 },
          "evidence_refs": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "screenplay_scene_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "screenplay_segment_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 },
          "shot_ids": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}

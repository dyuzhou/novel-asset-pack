{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Timeline",
  "type": "object",
  "required": ["events"],
  "properties": {
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "story_event_id", "order"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "story_event_id": { "type": "string", "minLength": 1 },
          "order": { "type": "integer", "minimum": 1 }
        },
        "additionalProperties": true
      }
    }
  },
  "additionalProperties": true
}
